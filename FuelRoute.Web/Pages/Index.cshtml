@page
@model IndexModel
@{
    ViewData["Title"] = "FuelRoute";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4 fw-bold">FuelRoute</h1>
        <p class="lead">Find the best gas prices along your route</p>
    </div>

    <div class="card shadow mx-auto mt-4" style="max-width: 600px;">
        <div class="card-body p-4">

            <h4 class="text-center mb-4">Plan Your Route</h4>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Start Location</label>
                    <input asp-for="StartLocation" class="form-control" placeholder="e.g. 100 City Centre Dr, Mississauga, ON" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">End Location</label>
                    <input asp-for="EndLocation" class="form-control" placeholder="e.g. 1 James St S, Hamilton, ON" />
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    Find Gas Stations
                </button>
            </form>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger mt-4">
                    @Model.ErrorMessage
                </div>
            }


            @if (Model.ApiResponse != null)
            {
                <div class="alert alert-success mt-4 p-4">
                    <h5 class="fw-bold">Best Gas Station Found:</h5>
                    <p><strong>@Model.ApiResponse.Station.Name</strong></p>
                    <p>Price: $@Model.ApiResponse.Station.Price</p>
                    <p>Distance: @Model.ApiResponse.DistanceKmFromStart km</p>

                    <a href="@Model.ApiResponse.MapsUrl"
                    target="_blank"
                    class="btn btn-primary w-100 mt-3">
                        Open in Google Maps
                    </a>
                </div>
            }




        </div>
    </div>
</div>
