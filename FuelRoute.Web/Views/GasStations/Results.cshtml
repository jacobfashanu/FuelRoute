@model IEnumerable<FuelRoute.Web.Models.GasStationResultViewModel>

@{
    ViewData["Title"] = "Gas Station Results";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2 class="mb-3">Gas Stations Along Your Route</h2>
            <div class="alert alert-info">
                <strong>Route:</strong> @ViewBag.StartLocation → @ViewBag.EndLocation
                <br />
                <strong>Total Distance:</strong> @ViewBag.TotalDistance km
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var station in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm gas-station-card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">@station.Brand</h5>
                        </div>
                        <div class="card-body">
                            <h6 class="card-title">@station.Name</h6>
                            <p class="card-text text-muted mb-2">
                                <i class="bi bi-geo-alt-fill"></i> @station.Address, @station.City
                            </p>
                            
                            <div class="price-section my-3 p-3 bg-light rounded">
                                <div class="row">
                                    <div class="col-6">
                                        <small class="text-muted">Price per Liter</small>
                                        <h3 class="text-success mb-0">$@station.CurrentPrice</h3>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Distance</small>
                                        <h4 class="text-primary mb-0">@station.DistanceFromRoute km</h4>
                                    </div>
                                </div>
                            </div>

                            @if (station.EstimatedSavings > 0)
                            {
                                <div class="alert alert-success py-2 mb-3">
                                    <strong>Save ~$@station.EstimatedSavings</strong> compared to average
                                </div>
                            }

                            <div class="station-features mb-3">
                                @if (station.Is24Hours)
                                {
                                    <span class="badge bg-info me-1">24 Hours</span>
                                }
                                <span class="badge bg-secondary">@station.FuelType</span>
                            </div>

                            <small class="text-muted d-block mb-2">
                                <i class="bi bi-clock"></i> Updated: @station.LastUpdated.ToString("MMM dd, hh:mm tt")
                            </small>
                        </div>
                        <div class="card-footer bg-white">
                            <a asp-controller="GasStations" 
                               asp-action="Details" 
                               asp-route-id="@station.StationId" 
                               class="btn btn-primary btn-sm w-100 mb-2">
                                <i class="bi bi-info-circle"></i> View Details
                            </a>
                            <a href="https://www.google.com/maps/dir/?api=1&destination=@station.Latitude,@station.Longitude" 
                               target="_blank" 
                               class="btn btn-outline-success btn-sm w-100">
                                <i class="bi bi-map"></i> Get Directions
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">No gas stations found!</h4>
            <p>We couldn't find any gas stations along your route. Try adjusting your search criteria or expanding your search radius.</p>
            <hr>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-search"></i> New Search
            </a>
        </div>
    }

    <div class="row mt-4">
        <div class="col-md-12">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Search
            </a>
        </div>
    </div>
</div>

<style>
    .gas-station-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .gas-station-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2) !important;
    }

    .price-section {
        border-left: 4px solid #28a745;
    }

    .station-features .badge {
        font-size: 0.85rem;
    }
</style>